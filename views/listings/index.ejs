<% layout("/layouts/boilerplate") -%>

<div id="listing-page" data-active-category="<%= typeof category !== 'undefined' ? category : '' %>">
<div id="filters">

  <div class="filter" id="Trending" onclick="window.location.href='/listings?category=Trending'">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>

  <div class="filter" id="Rooms" onclick="window.location.href='/listings?category=Rooms'">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>

  <div class="filter" id="Iconic Cities" onclick="window.location.href='/listings?category=Iconic%20Cities'">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </div>

  <div class="filter" id="Mountains" onclick="window.location.href='/listings?category=Mountains'">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </div>

  <div class="filter" id="Castles" onclick="window.location.href='/listings?category=Castles'">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </div>

  <div class="filter" id="Amazing Pools" onclick="window.location.href='/listings?category=Amazing%20Pools'">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </div>

  <div class="filter" id="Camping" onclick="window.location.href='/listings?category=Camping'">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </div>

  <div class="filter" id="Farms" onclick="window.location.href='/listings?category=Farms'">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </div>

  <div class="filter" id="Arctic" onclick="window.location.href='/listings?category=Arctic'">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arctic</p>
  </div>

  <div class="filter" id="Domes" onclick="window.location.href='/listings?category=Domes'">
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Domes</p>
  </div>

  <div class="filter" id="Boats" onclick="window.location.href='/listings?category=Boats'">
    <div><i class="fa-solid fa-ship"></i></div>
    <p>Boats</p>
  </div>
  
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch ">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
  </div>

 </div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <%for(let listing of allListing){%>
  <a href="/listings/<%=listing._id%>" class="listing-link">
    <div class="card listing-card col">
      <img
        src="<%= listing.image?.url || 'https://via.placeholder.com/600x400?text=No+Image' %>"
        class="card-img-top"
        alt="Listing-image"
        style="height: 20rem"
      />
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text">
          <b>
            <%=listing.title%>
          </b>
          <br />
          &#8377;
          <%=listing.price.toLocaleString("en-IN")%>/ night
          <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
        </p>
      </div>
    </div>
  </a>
  <%}%>
</div>
</div>
<script src="/js/listings.js"></script>