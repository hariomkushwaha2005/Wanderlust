<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3>Add New Listing</h3>
    <form
      action="/listings"
      method="post"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title" class="form-label">Add a Title</label>
        <input
          type="text"
          class="form-control"
          placeholder="enter title"
          name="listing[title]"
          required
        />
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          placeholder="description"
          name="listing[description]"
          class="form-control"
          required
        ></textarea>
      </div>
      <div class="mb-3">
        <label for="image" class="form-label">Upload Image</label>
        <input
          type="file"
          name="listing[image]"
          class="form-control"
          required
        />
      </div>
      <div class="mb-3">
        <label for="price" class="form-label">Price</label>
        <input
          type="number"
          placeholder="1200"
          name="listing[price]"
          class="form-control"
          required
        />
      </div>
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="country" class="form-label">Country</label>
          <input
            type="text"
            placeholder="India"
            name="listing[country]"
            class="form-control"
            required
          />
        </div>
        <div class="mb-3 col-md-8">
          <label for="location" class="form-label">Location</label>
          <input
            type="text"
            placeholder="Raisen, Madhya Pradesh"
            name="listing[location]"
            class="form-control"
            required
          />
        </div>
        <div class="mb-3 col-md-8">
          <label class="form-label d-block">Select Categories</label>
          <div class="d-flex flex-wrap gap-3">

            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="catTrending" name="listing[categories]" value="Trending">
              <label class="form-check-label" for="catTrending">Trending</label>
            </div>
            
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="catRooms" name="listing[categories]" value="Rooms">
              <label class="form-check-label" for="catRooms">Rooms</label>
            </div>
            
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="catIconicCities" name="listing[categories]" value="Iconic Cities">
              <label class="form-check-label" for="catIconicCities">Iconic Cities</label>
            </div>
            
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="catMountains" name="listing[categories]" value="Mountains">
              <label class="form-check-label" for="catMountains">Mountains</label>
            </div>
            
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="catCastles" name="listing[categories]" value="Castles">
              <label class="form-check-label" for="catCastles">Castles</label>
            </div>
            
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="catAmazingPools" name="listing[categories]" value="Amazing Pools">
              <label class="form-check-label" for="catAmazingPools">Amazing Pools</label>
            </div>
            
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="catCamping" name="listing[categories]" value="Camping">
              <label class="form-check-label" for="catCamping">Camping</label>
            </div>
            
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="catFarms" name="listing[categories]" value="Farms">
              <label class="form-check-label" for="catFarms">Farms</label>
            </div>
            
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="catArctic" name="listing[categories]" value="Arctic">
              <label class="form-check-label" for="catArctic">Arctic</label>
            </div>
            
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="catDomes" name="listing[categories]" value="Domes">
              <label class="form-check-label" for="catDomes">Domes</label>
            </div>
            
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="catBoats" name="listing[categories]" value="Boats">
              <label class="form-check-label" for="catBoats">Boats</label>
            </div>
            
          </div>
        </div>
      </div>
      <button class="btn btn-dark add-btn mt-3">Add</button>
    </form>
  </div>
</div>
